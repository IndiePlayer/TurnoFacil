# Vercel Storage > turnofacil-db > Connect Project injects DATABASE_URL automatically.
# For a manual Supabase connection, use its Session pooler URI here instead.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Generate a unique secret; set it only in Vercel environment variables.
JWT_SECRET=replace-with-a-long-random-secret

# Used only once to provision the production superadmin on an empty database.
INITIAL_SUPERADMIN_EMAIL=superadmin@turnofacil.com
INITIAL_SUPERADMIN_PASSWORD=choose-a-unique-strong-password
